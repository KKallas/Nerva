# Server
PORT=3000
BASE_URL=https://nerva.example.edu     # used inside QR codes and for the OAuth redirect
SESSION_SECRET=change-me-to-a-long-random-string

# Microsoft Entra ID (Azure AD) app registration
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Bootstrap admins (comma separated). Further admins are set in /admin.
ADMIN_EMAILS=you@narava.edu

# Local development only: skips Microsoft login and signs you in as this user.
# DEV_USER=you@narava.edu
