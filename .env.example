# Server
PORT=3000
# Leave BASE_URL unset while testing with "npm run phone": the tunnel address is
# picked up automatically. Set it once the app has a permanent home, so printed
# QR labels keep working.
# BASE_URL=https://nerva.example.edu
# Signs login cookies. Left as is, a random one is kept in data/session-secret.
SESSION_SECRET=change-me-to-a-long-random-string

# The built-in "admin" user is created on first start; the server prints a
# link to set its password. Forgot it? Stop Nerva and run: npm run reset-admin

# Default loan period in days
LOAN_DAYS=14
