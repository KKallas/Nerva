# Server
PORT=3000
# Leave BASE_URL unset while testing with "npm run phone": the tunnel address is
# picked up automatically. Set it once the app has a permanent home, so printed
# QR labels keep working.
# BASE_URL=https://nerva.example.edu
SESSION_SECRET=change-me-to-a-long-random-string

# Bootstrap admins (comma separated). Further admins are set in /admin.
ADMIN_EMAILS=you@narava.edu

# Default loan period in days
LOAN_DAYS=14
